generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                     String               @id @default(cuid())
  name                   String?
  email                  String?              @unique
  emailVerified          DateTime?
  image                  String?
  password               String?
  role                   String               @default("ADMIN") // ADMIN | APPROVER | EMPLOYEE
  staffId                String?              @unique
  mustChangePassword     Boolean              @default(false)
  disabledAt             DateTime?
  approvesAllDepartments Boolean              @default(false)
  accounts               Account[]
  sessions               Session[]
  staff                  Staff?               @relation(fields: [staffId], references: [id], onDelete: SetNull)
  approverDepartments   ApproverDepartment[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Department {
  id                  String               @id @default(cuid())
  name                String               @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  staffs              Staff[]
  approverDepartments ApproverDepartment[]
}

model Designation {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  staffs    Staff[]
}

model Shift {
  id        String   @id @default(cuid())
  name      String
  startTime String // e.g. "10:00"
  endTime   String // e.g. "16:00"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  staffs    Staff[]

  assignments ShiftAssignment[]
  suggestions ShiftSuggestion[] @relation("SuggestedShift")
}

model ShiftAssignment {
  id              String   @id @default(cuid())
  staffId         String
  shiftId         String?
  effectiveFrom   String // YYYY-MM-DD (IST day key)
  source          String // MANUAL | SUGGESTION | INITIAL
  createdByUserId String?
  createdAt       DateTime @default(now())

  staff Staff  @relation(fields: [staffId], references: [id], onDelete: Restrict)
  shift Shift? @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  @@unique([staffId, effectiveFrom])
  @@index([staffId, effectiveFrom])
}

model ShiftSuggestion {
  id                  String    @id @default(cuid())
  staffId             String
  fromShiftId         String?
  suggestedShiftId    String?
  suggestedStart      String
  suggestedEnd        String
  medianIn            String
  medianOut           String?
  daysObserved        Int
  daysWithinTolerance Int
  lateDays            Int
  patternSince        String
  direction           String
  status              String    @default("PENDING")
  dismissedUntil      String?
  decidedByUserId     String?
  decidedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  staff          Staff  @relation(fields: [staffId], references: [id], onDelete: Restrict)
  suggestedShift Shift? @relation("SuggestedShift", fields: [suggestedShiftId], references: [id], onDelete: SetNull)

  @@index([staffId, status])
}

model Device {
  id           String   @id @default(cuid())
  serialNumber String?  @unique
  name         String
  ipAddress    String?
  port         String?
  status       String   @default("OFFLINE")
  lastPing     DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Policy {
  id                          String    @id @default(cuid())
  name                        String    @default("GENERAL")
  earlyArrivalAllow           String    @default("02:00")
  maxOtAllow                  String    @default("08:00")
  otHalfCOffFrom              String    @default("00:00")
  otHalfCOffTo                String    @default("00:00")
  otFullCOffFrom              String    @default("00:00")
  otFullCOffTo                String    @default("00:00")
  lateArrivalAllow            String    @default("00:15")
  earlyDepartureAllow         String    @default("00:00")
  earlyArrivalIgnore          String    @default("00:00")
  lateDepartureIgnore         String    @default("00:00")
  overTimeIgnore              String    @default("00:00")
  noOfLate                    Int       @default(0)
  halfDayIfLateHrsGreaterThan String    @default("03:00")
  halfDayIfWorkHrsLessThan    String    @default("06:00")
  absentIfLateHrsGreaterThan  String    @default("00:00")
  absentIfWorkHrsLessThan     String    @default("00:00")
  shiftHrsForOtCalculation    String    @default("08:00")
  overtimePaymentMultiplier   Float     @default(0)
  allInOut                    String    @default("First IN Last OUT")
  weekOffDays                 String    @default("0") // e.g. "0" for Sunday
  shiftDetectionRanAt         DateTime?
  photoCleanupRanAt           DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
}

model Staff {
  id                 String   @id @default(cuid())
  machineId          String   @unique // ID as known to the attendance machine
  name               String
  employeeCode       String?  @unique
  joiningDate        String?  // YYYY-MM-DD (IST day key)
  departmentId       String?
  designationId      String?
  shiftId            String?
  profilePhotoId     String?
  profilePhotoPinned Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  department   Department?  @relation(fields: [departmentId], references: [id])
  designation  Designation? @relation(fields: [designationId], references: [id])
  shift        Shift?       @relation(fields: [shiftId], references: [id])
  profilePhoto PunchPhoto?  @relation("StaffProfilePhoto", fields: [profilePhotoId], references: [id], onDelete: SetNull)

  user              User?
  employmentPeriods EmploymentPeriod[]

  attendanceLogs   AttendanceLog[]
  dailyRecords     DailyRecord[]
  payrollInfo      StaffPayrollInfo?
  monthlyPayrolls  MonthlyPayroll[]
  shiftAssignments ShiftAssignment[]
  shiftSuggestions ShiftSuggestion[]
  punchPhotos      PunchPhoto[]      @relation("PunchPhotoOwner")
  punchRequests    PunchRequest[]
  profileChangeRequests ProfileChangeRequest[]
}

model AttendanceLog {
  id        String   @id @default(cuid())
  staffId   String
  timestamp DateTime
  type      String // "IN" or "OUT"

  staff Staff       @relation(fields: [staffId], references: [id], onDelete: Restrict)
  photo PunchPhoto?

  @@index([staffId])
  @@index([timestamp])
}

model PunchPhoto {
  id        String   @id @default(cuid())
  staffId   String
  logId     String?  @unique
  takenAt   DateTime
  data      Bytes
  isProfile Boolean  @default(false)
  createdAt DateTime @default(now())

  staff Staff          @relation("PunchPhotoOwner", fields: [staffId], references: [id], onDelete: Restrict)
  log   AttendanceLog? @relation(fields: [logId], references: [id], onDelete: SetNull)

  profileOf Staff[] @relation("StaffProfilePhoto")

  @@index([staffId, takenAt])
  @@index([takenAt])
}

model DailyRecord {
  id              String    @id @default(cuid())
  staffId         String
  date            DateTime
  status          String // "PRESENT", "ABSENT", "HALF_DAY"
  checkIn         DateTime?
  checkOut        DateTime?
  lateMinutes     Int       @default(0)
  workMinutes     Int       @default(0)
  overtimeMinutes Int       @default(0)

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@unique([staffId, date])
  @@index([date])
}

model Holiday {
  id        String   @id @default(cuid())
  name      String
  date      DateTime @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StaffPayrollInfo {
  id                 String  @id @default(cuid())
  staffId            String  @unique
  payGroup           String  @default("BANK_EPF") // BANK_EPF | CASH
  isActiveForPayroll Boolean @default(true)
  monthlyCtc         Float   @default(0)
  bankAccount        String?
  ifsc               String?
  nameAsPerBank      String?
  uan                String?
  nameOnUan          String?
  pan                String?
  aadhaar            String?

  // EPFO Bulk Reg Fields
  previousMemberId      String?
  dob                   DateTime?
  doj                   DateTime?
  gender                String?
  fatherHusbandName     String?
  relationship          String?
  mobileNumber          String?
  email                 String?
  nationality           String?   @default("INDIAN")
  qualification         String?
  maritalStatus         String?
  isInternationalWorker String?   @default("N")
  countryOfOrigin       String?   @default("INDIA")
  passportNumber        String?
  passportValidFrom     DateTime?
  passportValidTill     DateTime?
  isPhysicalHandicap    String?   @default("N")
  locomotive            String?   @default("N")
  hearing               String?   @default("N")
  visual                String?   @default("N")
  nameOnPan             String?
  nameOnAadhaar         String?
  isHigherPensionOpted  Boolean   @default(false)
  epfoKycExportedAt     DateTime?
  epfoKycExportedHash   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff           Staff            @relation(fields: [staffId], references: [id], onDelete: Restrict)
  payGroupChanges PayGroupChange[]
}

model MonthlyPayroll {
  id                  String   @id @default(cuid())
  staffId             String
  payGroup            String   @default("BANK_EPF") // BANK_EPF | CASH
  month               Int
  year                Int
  totalDays           Int
  presentDays         Float
  ncpDays             Float
  actualCtc           Float    @default(0)
  grossWage           Float    @default(0)
  basicWage           Float    @default(0)
  bonusAmount         Float    @default(0)
  bonusDays           Float?   @default(0)
  bonusType           String?  @default("CUSTOM")
  isBonusPfApplicable Boolean  @default(false)
  epfWages            Float    @default(0)
  epsWages            Float    @default(0)
  edliWages           Float    @default(0)
  employeeEpf         Float    @default(0)
  employerEps         Float    @default(0)
  employerEpf         Float    @default(0)
  refundOfAdvance     Float    @default(0)
  netPayment          Float    @default(0)
  isLocked            Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@unique([staffId, month, year])
  @@index([month, year])
}

model EmploymentPeriod {
  id              String    @id @default(cuid())
  staffId         String
  startDate       String    // YYYY-MM-DD
  endDate         String?   // YYYY-MM-DD
  exitReason      String?   // RESIGNED | TERMINATED | RETIRED | END_OF_CONTRACT | OTHER
  notes           String?
  createdByUserId String?
  epfoJoinExportedAt DateTime?
  epfoExitExportedAt DateTime?
  epfoExitCode       String?   // C | S | R | D | A | P
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

model ApproverDepartment {
  id           String     @id @default(cuid())
  userId       String
  departmentId String
  createdAt    DateTime   @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
}

model PayGroupChange {
  id                 String           @id @default(cuid())
  staffPayrollInfoId String
  payGroup           String           // BANK_EPF | CASH
  effectiveFromMonth String           // YYYY-MM
  createdByUserId    String?
  createdAt          DateTime         @default(now())

  staffPayrollInfo StaffPayrollInfo @relation(fields: [staffPayrollInfoId], references: [id], onDelete: Cascade)

  @@index([staffPayrollInfoId])
}

model UnmatchedPunch {
  id               String    @id @default(cuid())
  machineId        String
  timestamp        DateTime
  type             String    // IN | OUT
  receivedAt       DateTime  @default(now())
  reason           String    // UNKNOWN_ID | NOT_EMPLOYED
  resolvedAt       DateTime?
  resolvedByUserId String?
  resolution       String?   // ATTACHED | DISMISSED
  attachedStaffId  String?

  @@index([machineId])
  @@index([resolvedAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  at          DateTime @default(now())
  actorUserId String?
  action      String   // JOIN | EXIT | REJOIN | ROLE_CHANGE | SETUP_COMPLETED | etc.
  targetType  String   // Staff | User | Punch
  targetId    String?
  details     String?  // JSON string

  @@index([at])
  @@index([actorUserId])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PunchRequest {
  id               String    @id @default(cuid())
  staffId          String
  date             String    // YYYY-MM-DD IST day key
  punchType        String    // "IN" | "OUT" | "BOTH"
  requestedTime    String?
  requestedInTime  String?
  requestedOutTime String?
  reason           String    // e.g. "FORGOT_SWIPE" | "DUTY_OUTSIDE" | "DEVICE_OFFLINE" | "POWER_FAILURE" | "OTHER"
  explanation      String?
  status           String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED" | "CANCELLED"
  decidedByUserId  String?
  decidedAt        DateTime?
  decisionRemarks  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([staffId, status])
  @@index([date])
  @@index([status])
}

model ProfileChangeRequest {
  id              String    @id @default(cuid())
  staffId         String
  status          String    @default("PENDING")
  requestedData   String
  currentData     String?
  reason          String?
  decidedByUserId String?
  decidedAt       DateTime?
  decisionRemarks String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([staffId, status])
  @@index([status])
  @@index([createdAt])
}
