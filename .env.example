# Copy to .env and fill in. Never commit real secrets.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/attendance?schema=public"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
TZ="Asia/Kolkata"

# Optional legacy bootstrap: with an empty database, signing in with these credentials creates
# the first admin. There is no built-in password; leave DEFAULT_ADMIN_PASSWORD unset to keep this
# off (the setup wizard creates the first administrator on a fresh install).
# DEFAULT_ADMIN_EMAIL="admin@example.com"
# DEFAULT_ADMIN_PASSWORD="change-me"

# Initial Setup Wizard Secret (required to unlock /setup; in production there is no default)
SETUP_SECRET="choose-a-strong-secret-key-here"

# Optional: enables POST /api/attendance for HTTP biometric gateways. The gateway must send
# this value in the "x-attendance-key" header. Leave unset to keep the endpoint disabled.
# ATTENDANCE_PUSH_SECRET="choose-a-long-random-string"
